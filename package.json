{
  "name": "bureau-terminal-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Модель процессов «Приёмная депутата»: терминальный оператор, хронология заявок Git-графом и мобильный чат по ролям",
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "demo": "bun run src/cli/main.ts --auto 12",
    "test": "bun test",
    "e2e": "playwright test",
    "build:demo": "bun run scripts/build-web.ts demo",
    "serve:demo": "bun run scripts/serve-demo.ts",
    "screenshots": "bun run scripts/screenshots.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
